{
  "private": true,
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "lint": "NODE_OPTIONS=--max_old_space_size=2048 eslint --max-warnings 0 'assets/js/src/**/*.{js,jsx,ts,tsx}' 'tests/javascript-newsletter-editor/**/*.js'",
    "autoprefixer": "postcss assets/dist/css/*.css --use autoprefixer --no-map --replace",
    "scss": "sass assets/css/src/:assets/dist/css/ --style compressed",
    "stylelint": "stylelint --fix",
    "stylelint-check": "stylelint",
    "test": "env NODE_PATH=$NODE_PATH:./assets/js/src mocha --recursive --require tests/javascript/mocha-env.mjs  tests/javascript --extension spec.ts",
    "test:unit": "./do test:unit",
    "test:integration": "./do test:integration --skip-deps",
    "test:acceptance": "./do test:acceptance --skip-deps",
    "test:javascript": "./do test:javascript",
    "compile": "./do compile:all",
    "compile:js": "./do compile:js",
    "compile:css": "./do compile:css",
    "watch:js": "./do watch:js",
    "watch:css": "./do watch:css",
    "qa": "./do qa",
    "qa:js": "./do qa:lint-javascript",
    "qa:css": "./do qa:lint-css",
    "qa:php": "./do qa:php",
    "qa:phpstan": "./do qa:phpstan",
    "qa:prettier": "./do qa:prettier-check",
    "qa:fix": "./do qa:prettier-write",
    "changelog:add": "./do changelog:add",
    "generate:sample-data": "cd .. && wp-env run --env-cwd='wp-content/plugins/mailpoet' cli -- ./do generate:data",
    "migrations:new": "cd .. && wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do migrations:new",
    "migrations:status": "cd .. && wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do migrations:status",
    "templates": "cd .. && wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do templates",
    "wp": "cd .. && wp-env run cli wp",
    "shell": "cd .. && wp-env run cli bash",
    "check-types": "NODE_OPTIONS=--max_old_space_size=2048 tsc --noEmit",
    "postinstall": "INIT_CWD=$PWD ./tasks/npm_post_install.sh",
    "prepare": "cd .. && husky"
  },
  "lint-staged": {
    "*.{scss,css}": "tasks/lint-staged-css.sh",
    "*.{js,jsx,ts,tsx}": "tasks/lint-staged-js.sh",
    "*.php": "tasks/lint-staged-php.sh"
  },
