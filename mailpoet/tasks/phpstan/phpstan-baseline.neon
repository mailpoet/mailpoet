parameters:
	ignoreErrors:
		-
			message: '#^Method MailPoet\\WooCommerce\\Integrations\\AutomateWooHooks\:\:getAutomateWooCustomer\(\) should return AutomateWoo\\Customer\|false but returns AutomateWoo\\Customer\|bool\.$#'
			identifier: return.type
			count: 1
			path: ../../lib/WooCommerce/Integrations/AutomateWooHooks.php

		-
			message: '#^Cannot call method getTimestamp\(\) on int\<min, \-1\>\|int\<1, max\>\.$#'
			identifier: method.nonObject
			count: 1
			path: ../../lib/WooCommerce/WooCommerceBookings/Helper.php

		-
			message: '#^Call to an undefined method WC_Subscription\|WP_Error\:\:add_product\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../tests/DataFactories/WooCommerceSubscription.php

		-
			message: '#^Method MailPoet\\Test\\DataFactories\\WooCommerceSubscription\:\:createSubscription\(\) should return WC_Subscription but returns WC_Subscription\|WP_Error\.$#'
			identifier: return.type
			count: 1
			path: ../../tests/DataFactories/WooCommerceSubscription.php
