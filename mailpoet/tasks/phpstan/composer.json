{
  "require": {
    "php-stubs/woocommerce-stubs": "10.7.0",
    "php-stubs/wordpress-stubs": "v6.9.1",
    "phpstan/phpstan": "2.1.51",
    "phpstan/phpstan-doctrine": "2.0.21",
    "phpstan/phpstan-phpunit": "2.0.16",
    "szepeviktor/phpstan-wordpress": "2.0.3"
  },
  "autoload": {
    "psr-4": {
      "MailPoet\\PHPStan\\Extensions\\": "extensions"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "php prefix-phpstan-doctrine.php"
    ],
    "post-update-cmd": [
      "php prefix-phpstan-doctrine.php"
    ]
  }
}
