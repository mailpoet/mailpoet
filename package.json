{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --reporter append-only -r start",
    "bootstrap": "bash scripts/setup.sh",
    "env:start": "bash scripts/launch-smtp-catcher.sh && wp-env start",
    "env:stop": "wp-env stop; bash scripts/stop-smtp-catcher.sh",
    "env:destroy": "wp-env destroy --force; bash scripts/stop-smtp-catcher.sh",
    "env:restart": "wp-env destroy --force; bash scripts/stop-smtp-catcher.sh; bash scripts/launch-smtp-catcher.sh && wp-env start --update",
    "env:debug": "bash scripts/launch-smtp-catcher.sh && wp-env start --update --xdebug=develop,debug",
    "env:logs": "wp-env logs all",
    "shell": "wp-env run cli bash",
    "shell:test": "docker compose -f tests_env/docker/docker-compose.yml exec wordpress bash",
    "wp": "wp-env run cli wp",
    "compile": "cd mailpoet && ./do compile:all",
    "compile:js": "cd mailpoet && ./do compile:js",
    "compile:css": "cd mailpoet && ./do compile:css",
    "watch:js": "cd mailpoet && ./do watch:js",
    "watch:css": "cd mailpoet && ./do watch:css",
    "lint": "pnpm lint:php && pnpm lint:phpstan && pnpm lint:js && pnpm lint:css",
    "lint:php": "pnpm qa:php",
    "lint:phpstan": "pnpm qa:phpstan",
    "lint:js": "pnpm qa:js",
    "lint:css": "pnpm qa:css",
    "format": "pnpm qa:fix",
    "qa": "pnpm lint && pnpm qa:prettier && pnpm test:js",
    "qa:js": "cd mailpoet && ./do qa:lint-javascript",
    "qa:css": "cd mailpoet && ./do qa:lint-css",
    "qa:php": "cd mailpoet && ./do qa:php",
    "qa:phpstan": "cd mailpoet && ./do qa:phpstan",
    "qa:prettier": "cd mailpoet && ./do qa:prettier-check",
    "qa:fix": "cd mailpoet && ./do qa:prettier-write",
    "test:unit": "cd mailpoet && ./do test:unit ",
    "test:integration": "cd mailpoet && ./do test:integration --skip-deps",
    "test:acceptance": "cd mailpoet && ./do test:acceptance --skip-deps",
    "test:javascript": "cd mailpoet && ./do test:javascript",
    "test:php": "pnpm test:unit",
    "test:js": "pnpm test:javascript",
    "test:e2e": "pnpm test:acceptance",
    "test:integration:premium": "cd mailpoet-premium && ./do test:integration --skip-deps",
    "test:acceptance:premium": "cd mailpoet-premium && ./do test:acceptance --skip-deps",
    "test:install-deps": "cd mailpoet && ./do test:integration",
    "generate:sample-data": "wp-env run --env-cwd='wp-content/plugins/mailpoet' cli -- ./do generate:data",
    "migrations:new": "wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do migrations:new",
    "migrations:status": "wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do migrations:status",
    "changelog:add": "cd mailpoet && ./do changelog:add",
    "templates": "wp-env run --env-cwd='wp-content/plugins/mailpoet' cli ./do templates",
    "postinstall": "bash scripts/composer-install.sh"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^36.0.0",
    "lint-staged": "^12.5.0",
    "prettier": "2.6.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "24.21.0"
  }
}
